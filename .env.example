NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_MASTER_PASSWORD=your-admin-password

# WhatsApp posting bot
# From Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_TOKEN=your-access-token
# From Meta App Dashboard > App Settings > Basic > App Secret
WHATSAPP_APP_SECRET=your-app-secret
# Any string you invent, entered again in the webhook config screen
WHATSAPP_VERIFY_TOKEN=your-verify-token
# Only this number may post, in full international format, digits only
OWNER_WHATSAPP=27826365471
# Used to build the listing link in the confirmation reply
NEXT_PUBLIC_SITE_URL=https://ekwipt.co.za
